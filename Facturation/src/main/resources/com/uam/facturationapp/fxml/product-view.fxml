<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.uam.facturationapp.controller.ProductController"
            prefHeight="600.0" prefWidth="800.0">

    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
    </padding>

    <top>
        <VBox spacing="10.0">
            <BorderPane.margin>
                <Insets bottom="10.0"/>
            </BorderPane.margin>

            <Label text="Productos" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <HBox spacing="15.0">
                <GridPane hgap="10.0" vgap="8.0" HBox.hgrow="ALWAYS">
                    <columnConstraints>
                        <ColumnConstraints minWidth="90.0"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Código:"     GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="codeField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Nombre:"     GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="nameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Categoría:"  GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="categoryCombo" promptText="Seleccione..." maxWidth="Infinity"
                              GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Precio:"     GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="priceField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Existencia:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="stockField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <Label text="Estado:"     GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <CheckBox fx:id="activeCheck" text="Activo" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                </GridPane>

                <VBox spacing="8.0" alignment="TOP_CENTER">
                    <StackPane prefWidth="160.0" prefHeight="160.0" style="-fx-border-color: #bbbbbb;">
                        <ImageView fx:id="productImage" fitWidth="150.0" fitHeight="150.0" preserveRatio="true"/>
                    </StackPane>
                    <Button fx:id="imageButton" text="Seleccionar imagen..." onAction="#onSelectImage"/>
                </VBox>
            </HBox>

            <HBox spacing="10.0" alignment="CENTER_RIGHT">
                <Button fx:id="saveButton"  text="Guardar" onAction="#onSave"/>
                <Button fx:id="closeButton" text="Cerrar"  onAction="#onClose"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="productTable">
            <columns>
                <TableColumn fx:id="codeColumn"     text="Código"     prefWidth="90.0"/>
                <TableColumn fx:id="nameColumn"     text="Nombre"     prefWidth="200.0"/>
                <TableColumn fx:id="categoryColumn" text="Categoría"  prefWidth="120.0"/>
                <TableColumn fx:id="priceColumn"    text="Precio"     prefWidth="90.0"/>
                <TableColumn fx:id="stockColumn"    text="Existencia" prefWidth="90.0"/>
                <TableColumn fx:id="activeColumn"   text="Activo"     prefWidth="70.0"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>
</BorderPane>
