<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<!-- Se muestra dentro del centro de main-menu.fxml (ver ScreenManager). -->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.uam.facturationapp.controller.ProductController">

    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
    </padding>

    <top>
        <VBox spacing="10.0">
            <BorderPane.margin>
                <Insets bottom="10.0"/>
            </BorderPane.margin>

            <Label text="Gestión de productos" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <HBox spacing="15.0">
                <GridPane hgap="10.0" vgap="8.0" HBox.hgrow="ALWAYS">
                    <columnConstraints>
                        <ColumnConstraints minWidth="90.0"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Código:"     GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtCodigo" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Nombre:"     GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtNombre" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Categoría:"  GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="cmbCategoria" promptText="Seleccione..." maxWidth="Infinity"
                              GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Precio:"     GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtPrecio" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Existencia:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtExistencia" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <Label text="Estado:"     GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <CheckBox fx:id="chkActivo" text="Activo" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                </GridPane>

                <VBox spacing="8.0" alignment="TOP_CENTER">
                    <StackPane prefWidth="160.0" prefHeight="160.0" style="-fx-border-color: #bbbbbb;">
                        <ImageView fx:id="imgProducto" fitWidth="150.0" fitHeight="150.0" preserveRatio="true"/>
                    </StackPane>
                    <Button fx:id="btnImagen" text="Seleccionar imagen..." onAction="#seleccionarImagen"
                            maxWidth="Infinity"/>
                    <Button fx:id="btnQuitarImagen" text="Quitar imagen" onAction="#quitarImagen"
                            maxWidth="Infinity"/>
                </VBox>
            </HBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label text="Seleccione una fila para editarla o eliminarla." style="-fx-text-fill: #666666;"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnNuevo"    text="Nuevo"    onAction="#nuevo"/>
                <Button fx:id="btnGuardar"  text="Guardar"  onAction="#guardar"/>
                <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminar"/>
                <Button fx:id="btnCerrar"   text="Cerrar"   onAction="#cerrar"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tblProductos">
            <columns>
                <TableColumn fx:id="colCodigo"     text="Código"     prefWidth="90.0"/>
                <TableColumn fx:id="colNombre"     text="Nombre"     prefWidth="200.0"/>
                <TableColumn fx:id="colCategoria"  text="Categoría"  prefWidth="120.0"/>
                <TableColumn fx:id="colPrecio"     text="Precio"     prefWidth="90.0"/>
                <TableColumn fx:id="colExistencia" text="Existencia" prefWidth="90.0"/>
                <TableColumn fx:id="colActivo"     text="Activo"     prefWidth="70.0"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>
</BorderPane>
