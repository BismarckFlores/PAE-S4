<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<!-- Iconos: Material Design Icons (Apache 2.0), dibujados con SVGPath. -->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:id="contenedor"
            fx:controller="com.uam.facturationapp.controller.MainMenuController"
            stylesheets="@../css/styles.css"
            prefHeight="600.0" prefWidth="900.0">

    <top>
        <VBox>
            <MenuBar>
                <Menu text="Archivo">
                    <MenuItem fx:id="mnuInicio" text="Menú principal" accelerator="Shortcut+I" onAction="#irInicio"/>
                    <SeparatorMenuItem/>
                    <MenuItem fx:id="mnuSalir" text="Salir" onAction="#salir"/>
                </Menu>
                <Menu text="Inventario">
                    <MenuItem fx:id="mnuCategorias" text="Categorías" onAction="#abrirCategorias"/>
                    <MenuItem fx:id="mnuProductos" text="Productos" onAction="#abrirProductos"/>
                </Menu>
                <Menu text="Personal">
                    <MenuItem fx:id="mnuCargos" text="Cargos" onAction="#abrirCargos"/>
                    <MenuItem fx:id="mnuEmpleados" text="Empleados" onAction="#abrirEmpleados"/>
                </Menu>
            </MenuBar>

            <ToolBar>
                <Button fx:id="btnInicio" styleClass="boton-icono" accessibleText="Menú principal"
                        onAction="#irInicio">
                    <graphic>
                        <SVGPath styleClass="icono" content="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                    </graphic>
                    <tooltip><Tooltip text="Menú principal (Ctrl+I)" showDelay="300ms"/></tooltip>
                </Button>

                <Separator orientation="VERTICAL"/>

                <Button fx:id="btnCategorias" styleClass="boton-icono" accessibleText="Categorías"
                        onAction="#abrirCategorias">
                    <graphic>
                        <SVGPath styleClass="icono"
                                 content="M12 2l-5.5 9h11L12 2zm5.5 11c-2.49 0-4.5 2.01-4.5 4.5s2.01 4.5 4.5 4.5 4.5-2.01 4.5-4.5-2.01-4.5-4.5-4.5zM3 21.5h8v-8H3v8z"/>
                    </graphic>
                    <tooltip><Tooltip text="Categorías" showDelay="300ms"/></tooltip>
                </Button>
                <Button fx:id="btnProductos" styleClass="boton-icono" accessibleText="Productos"
                        onAction="#abrirProductos">
                    <graphic>
                        <SVGPath styleClass="icono"
                                 content="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
                    </graphic>
                    <tooltip><Tooltip text="Productos" showDelay="300ms"/></tooltip>
                </Button>

                <Separator orientation="VERTICAL"/>

                <Button fx:id="btnCargos" styleClass="boton-icono" accessibleText="Cargos"
                        onAction="#abrirCargos">
                    <graphic>
                        <SVGPath styleClass="icono"
                                 content="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z"/>
                    </graphic>
                    <tooltip><Tooltip text="Cargos" showDelay="300ms"/></tooltip>
                </Button>
                <Button fx:id="btnEmpleados" styleClass="boton-icono" accessibleText="Empleados"
                        onAction="#abrirEmpleados">
                    <graphic>
                        <SVGPath styleClass="icono"
                                 content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
                    </graphic>
                    <tooltip><Tooltip text="Empleados" showDelay="300ms"/></tooltip>
                </Button>

                <Pane HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnSalir" styleClass="boton-icono" accessibleText="Salir"
                        onAction="#salir">
                    <graphic>
                        <SVGPath styleClass="icono"
                                 content="M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"/>
                    </graphic>
                    <tooltip><Tooltip text="Salir" showDelay="300ms"/></tooltip>
                </Button>
            </ToolBar>
        </VBox>
    </top>

    <!-- Menú principal: ScreenManager lo guarda como vista de inicio y vuelve a él con "Cerrar" o "Inicio". -->
    <center>
        <VBox styleClass="inicio" alignment="CENTER" spacing="25.0">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>

            <VBox alignment="CENTER" spacing="4.0">
                <Label text="Sistema de facturación" styleClass="inicio-titulo"/>
                <Label text="Menú principal · seleccione un módulo" styleClass="inicio-subtitulo"/>
            </VBox>

            <!-- Cada icono va en un StackPane de alto fijo: miden distinto y así los títulos quedan alineados. -->
            <GridPane hgap="20.0" vgap="20.0" alignment="CENTER">
                <Button fx:id="btnTarjetaCategorias" styleClass="tarjeta" onAction="#abrirCategorias"
                        GridPane.rowIndex="0" GridPane.columnIndex="0">
                    <graphic>
                        <VBox spacing="6.0">                            <StackPane alignment="CENTER_LEFT" minHeight="24.0" prefHeight="24.0">
                                <SVGPath styleClass="icono"
                                         content="M12 2l-5.5 9h11L12 2zm5.5 11c-2.49 0-4.5 2.01-4.5 4.5s2.01 4.5 4.5 4.5 4.5-2.01 4.5-4.5-2.01-4.5-4.5-4.5zM3 21.5h8v-8H3v8z"/>
                            </StackPane>
                            <Label text="Categorías" styleClass="tarjeta-titulo"/>
                            <Label text="Clasificación de los productos" styleClass="tarjeta-descripcion"/>
                            <Label fx:id="lblTotalCategorias" styleClass="tarjeta-total"/>
                        </VBox>
                    </graphic>
                </Button>

                <Button fx:id="btnTarjetaProductos" styleClass="tarjeta" onAction="#abrirProductos"
                        GridPane.rowIndex="0" GridPane.columnIndex="1">
                    <graphic>
                        <VBox spacing="6.0">                            <StackPane alignment="CENTER_LEFT" minHeight="24.0" prefHeight="24.0">
                                <SVGPath styleClass="icono"
                                         content="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
                            </StackPane>
                            <Label text="Productos" styleClass="tarjeta-titulo"/>
                            <Label text="Catálogo, precios y existencias" styleClass="tarjeta-descripcion"/>
                            <Label fx:id="lblTotalProductos" styleClass="tarjeta-total"/>
                        </VBox>
                    </graphic>
                </Button>

                <Button fx:id="btnTarjetaCargos" styleClass="tarjeta" onAction="#abrirCargos"
                        GridPane.rowIndex="1" GridPane.columnIndex="0">
                    <graphic>
                        <VBox spacing="6.0">                            <StackPane alignment="CENTER_LEFT" minHeight="24.0" prefHeight="24.0">
                                <SVGPath styleClass="icono"
                                         content="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z"/>
                            </StackPane>
                            <Label text="Cargos" styleClass="tarjeta-titulo"/>
                            <Label text="Puestos de trabajo del negocio" styleClass="tarjeta-descripcion"/>
                            <Label fx:id="lblTotalCargos" styleClass="tarjeta-total"/>
                        </VBox>
                    </graphic>
                </Button>

                <Button fx:id="btnTarjetaEmpleados" styleClass="tarjeta" onAction="#abrirEmpleados"
                        GridPane.rowIndex="1" GridPane.columnIndex="1">
                    <graphic>
                        <VBox spacing="6.0">                            <StackPane alignment="CENTER_LEFT" minHeight="24.0" prefHeight="24.0">
                                <SVGPath styleClass="icono"
                                         content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
                            </StackPane>
                            <Label text="Empleados" styleClass="tarjeta-titulo"/>
                            <Label text="Personal y su cargo asignado" styleClass="tarjeta-descripcion"/>
                            <Label fx:id="lblTotalEmpleados" styleClass="tarjeta-total"/>
                        </VBox>
                    </graphic>
                </Button>
            </GridPane>

            <Label text="Vuelva a este menú en cualquier momento con el botón Inicio, Archivo › Menú principal o Ctrl+I."
                   styleClass="inicio-ayuda" wrapText="true"/>
        </VBox>
    </center>
</BorderPane>
