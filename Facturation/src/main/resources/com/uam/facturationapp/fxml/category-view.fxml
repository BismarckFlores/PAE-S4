<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- fx:controller="com.uam.facturationapp.controller.CategoryController" -->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.uam.facturationapp.controller.CategoryController"
      spacing="10.0" prefHeight="400.0" prefWidth="600.0">

    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
    </padding>

    <Label text="Categorías" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10.0" vgap="8.0">
        <columnConstraints>
            <ColumnConstraints minWidth="90.0"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="ID:"     GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="idField" editable="false" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Nombre:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Estado:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <CheckBox fx:id="activeCheck" text="Activa" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button fx:id="newButton"    text="Nuevo"    onAction="#onNew"/>
        <Button fx:id="saveButton"   text="Guardar"  onAction="#onSave"/>
        <Button fx:id="deleteButton" text="Eliminar" onAction="#onDelete"/>
    </HBox>

    <TableView fx:id="categoryTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn"     text="ID"     prefWidth="60.0"/>
            <TableColumn fx:id="nameColumn"   text="Nombre" prefWidth="300.0"/>
            <TableColumn fx:id="activeColumn" text="Activa" prefWidth="100.0"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

</VBox>