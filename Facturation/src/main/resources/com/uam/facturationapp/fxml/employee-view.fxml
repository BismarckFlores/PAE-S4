<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Se muestra dentro del centro de main-menu.fxml (ver ScreenManager). -->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.uam.facturationapp.controller.EmployeeController"
      spacing="10.0">

    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
    </padding>

    <Label text="Gestión de empleados" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10.0" vgap="8.0">
        <columnConstraints>
            <ColumnConstraints minWidth="90.0"/>
            <ColumnConstraints hgrow="ALWAYS"/>
            <ColumnConstraints minWidth="150.0"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="ID:"        GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtId" editable="false" focusTraversable="false" promptText="Automático"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Estado:"    GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <CheckBox fx:id="chkActivo" text="Activo" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

        <Label text="Nombres:"   GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNombres" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Apellidos:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <TextField fx:id="txtApellidos" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

        <Label text="Cargo:"     GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbCargo" promptText="Seleccione..." maxWidth="Infinity"
                  GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Fecha de contratación:" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
        <DatePicker fx:id="dpFechaContratacion" editable="false" promptText="Seleccione..." maxWidth="Infinity"
                    GridPane.rowIndex="2" GridPane.columnIndex="3"/>
    </GridPane>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Seleccione una fila para editarla o eliminarla." style="-fx-text-fill: #666666;"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnNuevo"    text="Nuevo"    onAction="#nuevo"/>
        <Button fx:id="btnGuardar"  text="Guardar"  onAction="#guardar"/>
        <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminar"/>
        <Button fx:id="btnCerrar"   text="Cerrar"   onAction="#cerrar"/>
    </HBox>

    <TableView fx:id="tblEmpleados" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId"                text="ID"            prefWidth="50.0"/>
            <TableColumn fx:id="colNombres"           text="Nombres"       prefWidth="150.0"/>
            <TableColumn fx:id="colApellidos"         text="Apellidos"     prefWidth="150.0"/>
            <TableColumn fx:id="colCargo"             text="Cargo"         prefWidth="130.0"/>
            <TableColumn fx:id="colFechaContratacion" text="Contratación"  prefWidth="110.0"/>
            <TableColumn fx:id="colActivo"            text="Activo"        prefWidth="70.0"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</VBox>
